<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- V8 in Electron and in the bundled node needs both under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- The bundled node runs other people's native addons, which carry another team's signature. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Without it the hardened runtime denies the microphone to the app and to pantheon-voice without a prompt. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
